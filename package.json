{
  "name": "junkpack-boss-rush",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "assets:atlas": "node scripts/build-atlases.mjs",
    "assets:check": "node scripts/check-asset-budget.mjs",
    "assets:store": "node scripts/build-store-art.mjs && node scripts/check-store-art.mjs",
    "assets:prepare": "npm run assets:atlas && npm run assets:check && npm run assets:store",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "release:check": "node scripts/check-release-readiness.mjs",
    "release:check:soft-launch": "node scripts/check-release-readiness.mjs --require-analytics",
    "release:archive": "node scripts/build-portal-package.mjs",
    "release:verify": "node scripts/check-portal-package.mjs",
    "release:package": "npm run build && npm run release:check && npm run release:archive && npm run release:verify",
    "release:soft-launch": "npm run build && npm run release:check:soft-launch && npm run release:archive && npm run release:verify",
    "dev": "npm run assets:prepare && vite",
    "build": "npm run assets:prepare && tsc --noEmit && vite build && npm run bundle:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:watch": "vitest --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "fflate": "0.8.2",
    "sharp": "0.35.3",
    "typescript": "5.9.2",
    "vite": "8.0.0",
    "vitest": "4.0.0"
  }
}
